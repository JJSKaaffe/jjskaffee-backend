# Copia este archivo como .env (está en .gitignore) y llena los valores.
# Lo lee el perfil "local". Formato .properties: CLAVE=valor, sin comillas.
# Si la contraseña tiene "\" escríbela como "\\".

# PostgreSQL local (base creada con db/01 y db/02)
JJSKAFFEE_DB_URL=jdbc:postgresql://localhost:5432/jjskaffee
JJSKAFFEE_DB_USUARIO=app_jjskaffee
JJSKAFFEE_DB_CLAVE=

# Firebase Authentication: id del proyecto (Firebase Console > Configuración del proyecto)
JJSKAFFEE_FIREBASE_PROJECT_ID=
# Ruta al JSON de la cuenta de servicio, FUERA del repo (p. ej. C:/Users/<tu usuario>/secretos/jjskaffee-firebase.json).
# Déjalo vacío si usas "gcloud auth application-default login".
JJSKAFFEE_FIREBASE_CREDENCIALES=
