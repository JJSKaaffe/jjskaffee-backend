# Copia este archivo como ".env" (está en .gitignore) y llena los valores.
# Solo lo lee el perfil "local". En la nube, los valores vienen de Secret Manager (ADR-0014).

JJSKAFFEE_DB_URL=jdbc:postgresql://localhost:5432/jjskaffee?currentSchema=jjskaffee
JJSKAFFEE_DB_USUARIO=app_jjskaffee
JJSKAFFEE_DB_CONTRASENA=

# desarrollo = tokens dev:<id_cafeteria>:<firebase_uid> (solo en tu PC) · firebase = tokens reales
JJSKAFFEE_MODO_SEGURIDAD=desarrollo
JJSKAFFEE_FIREBASE_PROYECTO=
# Modo firebase: además define la VARIABLE DE ENTORNO del sistema GOOGLE_APPLICATION_CREDENTIALS
# con la ruta al JSON de la cuenta de servicio (este archivo no sirve para eso). Nunca subas ese JSON.

JJSKAFFEE_CORS_ORIGENES=http://localhost:5173
